      "id": "c7be4dbc-5c0f-416d-9820-0eee8cca52c8",
      "name": "Events",
      "description": {
        "content": "Endpoints for sending behavioral and interaction events from storefronts to Sitecore Discover. Events include clicks, purchases, and page views that improve recommendation relevance over time.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "245d019f-b248-422e-b644-b162835daaac",
          "name": "Track a behavioral event (GET)",
          "request": {
            "name": "Track a behavioral event (GET)",
            "description": {
              "content": "Sends a behavioral event from a storefront visitor session to Sitecore Discover. Events are used to improve the relevance of search results and product recommendations. The key parameter contains a URL-encoded JSON object with the event details.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "event",
                "1"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "customerKey",
                  "value": "<string>",
                  "description": "The customer key identifying the Sitecore Discover account. Found in the Customer Engagement Console under Developer Resources > API Access."
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) URL-encoded JSON object containing event details"
                }
              ],
              "variable": []
            },
            "header": [
