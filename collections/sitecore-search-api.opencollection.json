{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sitecore CDP REST Audit Search API",
    "version": "v2.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
